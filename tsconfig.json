{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true, "types": ["node", "vite/client"]
  }, "include": ["src", "tests", "vite.config.ts"]
}
